-- 7. Fonction d'appel central
local function GetKids(parent)
	local kids = {}
	for _, v in pairs(parent:GetDescendants()) do
		kids[v] = kids[v] or {}
	end
	for _, v in pairs(parent:GetDescendants()) do
		kids[v][#kids[v] + 1] = v
	end
	return kids
end

